      "name": "Markdown list punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#D62B18"
      }
    },
    {
      "name": "Markdown separator and table",
      "scope": [
        "meta.separator.markdown",
        "punctuation.definition.table.markdown",
        "markup.table"
      ],
      "settings": {
        "foreground": "#4A636E"
      }
    },
    {
      "name": "Diff / patch inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff",
        "punctuation.definition.inserted.diff",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#3A7A00"
      }
    },
    {
      "name": "Diff / patch deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff",
        "punctuation.definition.deleted.diff",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#D62B18"
      }
    },
    {
      "name": "Diff / patch changed and header",
      "scope": [
        "markup.changed",
        "markup.changed.diff",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#9A5E00"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A62011",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#4A636E",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Embedded reset",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#1B3139"
      }
    }
  ]
}
