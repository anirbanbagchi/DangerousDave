      "settings": {
        "foreground": "#8DA1A9"
      }
    },
    {
      "name": "Diff / patch inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff",
        "punctuation.definition.inserted.diff",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#A5D24A"
      }
    },
    {
      "name": "Diff / patch deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff",
        "punctuation.definition.deleted.diff",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FF3621"
      }
    },
    {
      "name": "Diff / patch changed and header",
      "scope": [
        "markup.changed",
        "markup.changed.diff",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#F0AE4A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF8A76",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8DA1A9",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Embedded reset",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#D6DFE2"
      }
    }
  ]
}
