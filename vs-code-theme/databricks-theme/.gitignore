# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/*
!.vscode/extensions.json

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Packaged builds are published artifacts in this repo, the same as the other
# themes under vs-code-theme/. This negation overrides the root .gitignore's
# `*.vsix` rule so `vsce package --out dist/…` output is tracked without -f.
!dist/*.vsix

# Build / temp
out/

# Misc
*.log
