  },
  "license": "MIT",
  "keywords": [
    "theme",
    "color-theme",
    "python",
    "sql",
    "csharp",
    "databricks",
    "docker",
    "yaml",
    "json",
    "jupyter",
    "devops",
    "cicd"
  ],
  "contributes": {
    "themes": [
      {
        "label": "CodeMash Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/CodeMash-Dark-color-theme.json"
