    "editorCursor.foreground": "#f67f01",
    "editor.selectionBackground": "#0C84A955",
    "editor.inactiveSelectionBackground": "#0C84A933",
    "editor.wordHighlightBackground": "#16A1C833",
    "editor.wordHighlightStrongBackground": "#16A1C855",
    "editor.findMatchBackground": "#F67F0140",
