    "titleBar.inactiveForeground": "#FFFFFF99",
    "panel.background": "#071E25",
    "panel.border": "#0C84A940",
    "terminal.background": "#071E25",
    "terminal.foreground": "#EAF6FA",
    "terminalCursor.foreground": "#f67f01",
    "terminal.ansiBlue": "#0c84a9",
    "terminal.ansiCyan": "#16A1C8",
    "terminal.ansiGreen": "#94C53C",
    "terminal.ansiYellow": "#f67f01",
    "terminal.ansiBrightBlue": "#16A1C8",
    "terminal.ansiBrightGreen": "#94C53C",
    "terminal.ansiBrightYellow": "#f67f01",
    "terminal.ansiWhite": "#FFFFFF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "breadcrumb.foreground": "#8FB9C6",
    "breadcrumb.focusForeground": "#FFFFFF",
    "breadcrumb.activeSelectionForeground": "#FFFFFF",
    "list.activeSelectionBackground": "#16A1C833",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#0C84A925",
    "list.inactiveSelectionBackground": "#0C84A918",
    "list.focusOutline": "#16A1C8",
    "input.background": "#0A2F3A",
    "input.foreground": "#FFFFFF",
    "input.border": "#0C84A940",
    "inputOption.activeBorder": "#94C53C",
    "inputValidation.errorBorder": "#f67f01",
    "inputValidation.warningBorder": "#f67f01",
    "inputValidation.infoBorder": "#16A1C8",
    "dropdown.background": "#0A2F3A",
    "dropdown.foreground": "#FFFFFF",
    "dropdown.border": "#0C84A940",
    "button.background": "#0c84a9",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#16A1C8",
    "badge.background": "#0C84A940",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#94C53C",
    "peekView.border": "#16A1C8",
    "peekViewEditor.background": "#071E25",
    "peekViewResult.background": "#0A2F3A",
    "peekViewTitle.background": "#0A2F3A",
    "diffEditor.insertedTextBackground": "#94C53C22",
    "diffEditor.removedTextBackground": "#F67F0122"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7FA7B3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#94C53C"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f67f01"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#16A1C8"
      }
    },
    {
      "name": "Control Keywords (Python/SQL)",
      "scope": [
        "keyword.control",
        "keyword.other",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#16A1C8"
      }
    },
    {
      "name": "Functions / Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Classes / Types / Namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#0c84a9"
      }
    },
    {
      "name": "Variables / Parameters",
      "scope": [
        "variable",
        "meta.parameter.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EAF6FA"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f67f01"
      }
    },
    {
      "name": "Decorators / Attributes",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#0c84a9"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "entity.name.tag.yaml",
        "meta.mapping.key"
      ],
      "settings": {
        "foreground": "#16A1C8"
      }
    },
    {
      "name": "SQL identifiers",
      "scope": [
        "source.sql",
        "entity.name.table",
        "entity.name.column",
        "support.function.sql",
        "entity.name.function.sql"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Dockerfile keywords",
      "scope": [
        "source.dockerfile",
        "keyword.other.dockerfile",
        "support.function.dockerfile"
      ],
      "settings": {
        "foreground": "#16A1C8"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f67f01",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#94C53C"
      }
    },
    {
      "name": "Diff - Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#94C53C"
      }
    },
    {
      "name": "Diff - Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f67f01"
      }
    }
  ]
}