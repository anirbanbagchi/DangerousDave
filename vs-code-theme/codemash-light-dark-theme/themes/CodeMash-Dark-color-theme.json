    "activityBar.inactiveForeground": "#8FB9C688",
    "activityBarBadge.background": "#f67f01",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#0A2F3A",
    "sideBar.foreground": "#EAF6FA",
    "sideBarSectionHeader.background": "#0C84A920",
