  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "rgba(72,185,199,0.78)", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#26d076" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language.numeric"],
      "settings": { "foreground": "#faa41a" }
    },
    {
      "name": "Booleans / null",
      "scope": ["constant.language.boolean", "constant.language.null"],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete"
      ],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "Functions / methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.method",
        "support.function.any-method"
      ],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Namespaces / modules",
      "scope": ["entity.name.namespace", "support.module", "entity.name.module"],
      "settings": { "foreground": "rgba(255,255,255,0.85)" }
    },
    {
      "name": "Variables / parameters",
      "scope": ["variable", "variable.parameter", "meta.parameter", "variable.other.readwrite"],
      "settings": { "foreground": "rgba(255,255,255,0.88)" }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "entity.name.constant", "support.constant"],
      "settings": { "foreground": "#faa41a" }
    },
    {
      "name": "Decorators / annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#48b9c7", "fontStyle": "bold" }
    },
    {
      "name": "Imports",
      "scope": ["keyword.control.import", "keyword.control.from", "meta.import"],
      "settings": { "foreground": "#faa41a" }
    },
    {
      "name": "Docstrings (Python)",
      "scope": ["string.quoted.docstring.multi.python", "string.quoted.docstring.single.python"],
      "settings": { "foreground": "rgba(38,208,118,0.78)", "fontStyle": "italic" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "string.json meta.mapping.key"],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "YAML keys",
      "scope": ["entity.name.tag.yaml", "meta.map.key.yaml"],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "SQL keywords",
      "scope": ["keyword.other.sql", "keyword.control.sql"],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold" }
    },
    {
      "name": "SQL functions",
      "scope": ["support.function.sql", "entity.name.function.sql"],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "Dockerfile directives",
      "scope": ["keyword.other.special-method.dockerfile", "support.function.dockerfile"],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold" }
    },
    {
      "name": "YAML/JSON punctuation",
      "scope": [
        "punctuation.definition.dictionary",
        "punctuation.definition.array",
        "punctuation.separator.key-value"
      ],
      "settings": { "foreground": "rgba(255,255,255,0.65)" }
    },
    {
      "name": "Invalid / errors",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "#dc4405", "fontStyle": "bold" }
    },

    {
      "name": "GitHub Actions / Azure DevOps YAML - keys (high value)",
      "scope": [
        "source.yaml.github-actions meta.map.key.yaml",
        "source.yaml.azure-pipelines meta.map.key.yaml",
        "source.yaml.github-actions entity.name.tag.yaml",
        "source.yaml.azure-pipelines entity.name.tag.yaml",
        "source.yaml.github-actions meta.mapping.key.yaml",
        "source.yaml.azure-pipelines meta.mapping.key.yaml"
      ],
      "settings": { "foreground": "#48b9c7", "fontStyle": "bold" }
    },
    {
      "name": "GitHub Actions / Azure DevOps YAML - scalars/values",
      "scope": [
        "source.yaml.github-actions string.unquoted.plain.out.yaml",
        "source.yaml.azure-pipelines string.unquoted.plain.out.yaml",
        "source.yaml.github-actions string.quoted.single.yaml",
        "source.yaml.github-actions string.quoted.double.yaml",
        "source.yaml.azure-pipelines string.quoted.single.yaml",
        "source.yaml.azure-pipelines string.quoted.double.yaml"
      ],
      "settings": { "foreground": "#26d076" }
    },
    {
      "name": "GitHub Actions / Azure DevOps YAML - expressions",
      "scope": [
        "source.yaml.github-actions constant.character.format.placeholder.other",
        "source.yaml.github-actions meta.embedded.block",
        "source.yaml.azure-pipelines constant.character.format.placeholder.other",
        "source.yaml.azure-pipelines meta.embedded.block"
      ],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold" }
    },

    {
      "name": "Databricks SQL - table/schema identifiers",
      "scope": [
        "source.sql.databricks entity.name.table",
        "source.sql.databricks entity.name.schema",
        "source.sql.databricks entity.name.database",
        "source.sql entity.name.table",
        "source.sql entity.name.schema",
        "source.sql entity.name.database"
      ],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "Databricks SQL - columns/fields",
      "scope": [
        "source.sql.databricks variable.other.member",
        "source.sql.databricks variable.other.column",
        "source.sql variable.other.member",
        "source.sql variable.other.column"
      ],
      "settings": { "foreground": "rgba(255,255,255,0.88)" }
    },
    {
      "name": "Databricks SQL - functions",
      "scope": [
        "source.sql.databricks support.function",
        "source.sql.databricks entity.name.function",
        "source.sql support.function",
        "source.sql entity.name.function"
      ],
      "settings": { "foreground": "#48b9c7" }
    },
    {
      "name": "Databricks SQL - types/casts",
      "scope": [
        "source.sql.databricks support.type",
        "source.sql.databricks storage.type",
        "source.sql support.type",
        "source.sql storage.type"
      ],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },

    {
      "name": "Spark SQL / Delta Lake - special keywords (MERGE/OPTIMIZE/ZORDER/VACUUM/etc.)",
      "scope": [
        "source.sql.spark keyword.other.spark",
        "source.sql.spark keyword.control.spark",
        "source.sql.spark keyword.other.dml",
        "source.sql.spark keyword.other.ddl",
        "source.sql.spark keyword.other.delta",
        "source.sql.spark keyword.control.delta",
        "source.sql.databricks keyword.other.delta",
        "source.sql.databricks keyword.control.delta",
        "keyword.other.spark.sql",
        "keyword.control.spark.sql",
        "keyword.other.delta.sql",
        "keyword.control.delta.sql",
        "keyword.other.deltalake.sql",
        "keyword.control.deltalake.sql"
      ],
      "settings": { "foreground": "#faa41a", "fontStyle": "bold underline" }
    }
  ],

  "semanticTokenColors": {
    "namespace": "rgba(255,255,255,0.85)",
    "class": "#FFFFFF",
    "type": "#FFFFFF",
    "struct": "#FFFFFF",
    "interface": "#FFFFFF",
    "enum": "#FFFFFF",

    "function": "#48b9c7",
    "method": "#48b9c7",

    "property": "rgba(255,255,255,0.88)",
    "parameter": "rgba(255,255,255,0.88)",
    "variable": "rgba(255,255,255,0.88)",

    "keyword": "#faa41a",
    "number": "#faa41a",
    "string": "#26d076",

    "comment": "rgba(72,185,199,0.78)",
    "operator": "#48b9c7",
    "decorator": "#48b9c7",
    "regexp": "#26d076"
  }
}