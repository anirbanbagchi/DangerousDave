    "list.activeSelectionBackground": "rgba(72,185,199,0.24)",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "rgba(72,185,199,0.16)",
    "list.hoverBackground": "rgba(255,255,255,0.06)",
