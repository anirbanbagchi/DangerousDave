    "badge.foreground": "#FFFFFF",

    "gitDecoration.addedResourceForeground": "#26d076",
    "gitDecoration.modifiedResourceForeground": "#faa41a",
    "gitDecoration.deletedResourceForeground": "#dc4405",
    "gitDecoration.untrackedResourceForeground": "#48b9c7",
    "gitDecoration.ignoredResourceForeground": "rgba(255,255,255,0.45)",

    "editorGutter.addedBackground": "rgba(38,208,118,0.40)",
    "editorGutter.modifiedBackground": "rgba(250,164,26,0.40)",
