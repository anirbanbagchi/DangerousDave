    "terminal.ansiYellow": "#faa41a",
    "terminal.ansiRed": "#dc4405",
    "terminal.ansiBrightBlack": "rgba(255,255,255,0.35)",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "terminal.ansiBrightCyan": "#48b9c7",
