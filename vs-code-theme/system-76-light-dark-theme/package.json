{
  "name": "system76",
  "displayName": "System76",
  "description": "System76 theme optimized for Python, Databricks, C#, SQL, CI/CD, JSON, YAML, Docker, and data engineering. Includes Dark + Light variants.",
  "version": "0.1.0",
  "publisher": "anirbanbagchi",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Themes"],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "python",
    "databricks",
    "spark sql",
    "delta lake",
    "csharp",
    "sql",
    "json",
    "yaml",
    "docker",
    "cicd",
    "data engineering",
    "github actions",
    "azure devops"
  ],
  "files": [
    "themes/**",
    "images/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "themes": [
      {
        "label": "System76",
        "uiTheme": "vs-dark",
        "path": "./themes/System76-color-theme.json"
      },
      {
        "label": "System76 Light",
        "uiTheme": "vs",
        "path": "./themes/System76-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anirbanbagchi/DangerousDave/vs-code-theme/system-76-light-dark-theme"
  },
