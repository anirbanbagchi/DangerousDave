		//"testing.message.info.lineBackground": null,
		//"textPreformat.border": null,
		//"titleBar.border": null,
		//"toolbar.hoverOutline": null,
		//"welcomePage.background": null,
		//"widget.border": null,
		//"window.activeBorder": null,
		//"window.inactiveBorder": null
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#3F0E40",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#2BAC76"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character.escape",
				"constant.other.placeholder"
			],
			"settings": {
				"foreground": "#CD2553"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#1164A3",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#1164A3"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#3F0E40",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable",
				"identifier"
			],
			"settings": {
				"foreground": "#350D36"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.parameters"
			],
			"settings": {
				"foreground": "#350D36",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"meta.annotation.python",
				"punctuation.definition.decorator"
			],
			"settings": {
				"foreground": "#CD2553"
			}
		},
		{
			"scope": [
				"keyword.control.import",
				"keyword.control.from",
				"support.module"
			],
			"settings": {
				"foreground": "#1164A3",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.other.DDL",
				"keyword.other.DML",
				"keyword.other.sql",
				"support.function.scalar.sql"
			],
			"settings": {
				"foreground": "#1164A3",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
				"meta.mapping.key.yaml",
				"string.unquoted.plain.out.yaml"
			],
			"settings": {
				"foreground": "#3F0E40"
			}
		},
		{
			"scope": [
				"punctuation.separator.key-value.json",
				"punctuation.definition.mapping.yaml",
				"punctuation.separator.mapping.key-value.yaml"
			],
			"settings": {
				"foreground": "#350D36"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"meta.diff.header.from-file"
			],
			"settings": {
				"foreground": "#2BAC76"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal",
				"markup.deleted"
			],
			"settings": {
				"foreground": "#CD2553"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#316BCD"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#CD9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#CD3131"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#800080"
			}
		}
	]
}