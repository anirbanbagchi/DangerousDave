{
  "name": "Python Light",
  "type": "light",
  "colors": {
    "editor.background": "#F4F4F4",
    "editor.foreground": "#306998",
    "activityBarBadge.background": "#FFD43B",
    "sideBarTitle.foreground": "#306998",
    "sideBar.background": "#FAFAFA",
    "sideBar.foreground": "#306998",
    "sideBarSectionHeader.background": "#FFE873",
    "sideBarSectionHeader.foreground": "#306998",
    "list.activeSelectionBackground": "#FFE873",
    "list.activeSelectionForeground": "#306998",
    "list.inactiveSelectionBackground": "#FFE87350",
    "list.hoverBackground": "#FFE87330",
    "list.focusBackground": "#FFE873",
    "statusBar.background": "#306998",
    "statusBar.foreground": "#FFD43B",
    "statusBar.debuggingBackground": "#5A9FD4",
    "statusBar.debuggingForeground": "#F4F4F4",
    "statusBar.noFolderBackground": "#7F7F7F",
    "titleBar.activeBackground": "#306998",
    "titleBar.activeForeground": "#FFD43B",
    "titleBar.inactiveBackground": "#5A9FD4",
    "titleBar.inactiveForeground": "#F4F4F4",
    "activityBar.background": "#306998",
    "activityBar.foreground": "#FFD43B",
    "activityBar.inactiveForeground": "#FFE873",
    "editorGroupHeader.tabsBackground": "#E8E8E8",
    "tab.activeBackground": "#F4F4F4",
    "tab.activeForeground": "#306998",
    "tab.inactiveBackground": "#E0E0E0",
    "tab.inactiveForeground": "#7F7F7F",
    "tab.border": "#D0D0D0",
    "editorLineNumber.foreground": "#7F7F7F",
    "editorLineNumber.activeForeground": "#306998",
    "editorCursor.foreground": "#FFD43B",
    "editor.selectionBackground": "#FFE87370",
    "editor.selectionHighlightBackground": "#FFE87340",
    "editor.wordHighlightBackground": "#5A9FD430",
    "editor.findMatchBackground": "#FFD43B80",
    "editor.findMatchHighlightBackground": "#FFE87360",
    "editorBracketMatch.background": "#FFD43B40",
    "editorBracketMatch.border": "#FFD43B",
    "editorWhitespace.foreground": "#D0D0D0",
    "editorIndentGuide.background": "#E0E0E0",
    "editorIndentGuide.activeBackground": "#FFD43B",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#306998",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.selectedBackground": "#FFE873",
    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.border": "#5A9FD4",
    "panel.background": "#F4F4F4",
    "panel.border": "#D0D0D0",
    "panelTitle.activeBorder": "#FFD43B",
    "panelTitle.activeForeground": "#306998",
    "panelTitle.inactiveForeground": "#7F7F7F",
    "terminal.background": "#F4F4F4",
    "terminal.foreground": "#306998",
    "terminal.ansiBlue": "#5A9FD4",
    "terminal.ansiYellow": "#FFD43B",
    "terminalCursor.foreground": "#FFD43B",
    "button.background": "#FFD43B",
    "button.foreground": "#306998",
    "input.background": "#FFFFFF",
    "input.border": "#D0D0D0",
    "input.foreground": "#306998",
    "inputOption.activeBorder": "#FFD43B",
    "focusBorder": "#FFD43B",
    "badge.background": "#FFD43B",
    "badge.foreground": "#306998",
    "progressBar.background": "#FFD43B",
    "debugToolBar.background": "#306998",
    "debugToolBar.border": "#5A9FD4",
    "notifications.background": "#FFFFFF",
    "notifications.foreground": "#306998",
    "notificationLink.foreground": "#5A9FD4",
    "gitDecoration.modifiedResourceForeground": "#FFD43B",
    "gitDecoration.deletedResourceForeground": "#E74C3C",
    "gitDecoration.untrackedResourceForeground": "#5A9FD4",
    "gitDecoration.ignoredResourceForeground": "#7F7F7F",
    "gitDecoration.conflictingResourceForeground": "#FF6B6B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F7F7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#5A9FD4"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FFD43B"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python Keywords (def, class, import, etc.)",
      "scope": [
        "keyword.control.import.python",
        "keyword.control.flow.python",
        "storage.type.function.python",
        "storage.type.class.python"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions and Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#5A9FD4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes and Types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#306998"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#306998"
      }
    },
    {
      "name": "Object Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#5A9FD4"
      }
    },
    {
      "name": "Decorators (Python)",
      "scope": [
        "entity.name.function.decorator.python",
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#FFD43B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Magic Methods (Python)",
      "scope": [
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#FFE873",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#306998"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#7F7F7F"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Docker Keywords",
      "scope": [
        "keyword.other.special-method.dockerfile",
        "keyword.operator.dockerfile"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C# Attributes",
      "scope": [
        "entity.name.type.attribute.cs"
      ],
      "settings": {
        "foreground": "#FFD43B"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#306998",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#5A9FD4"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#FFD43B"
      }
    },
    {
      "name": "SQL Table Names",
      "scope": [
        "entity.name.function.sql",
        "constant.other.database-name.sql",
        "constant.other.table-name.sql"
      ],
      "settings": {
        "foreground": "#5A9FD4"
      }
    },
    {
      "name": "RegEx",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FFE873"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FFD43B"
      }
    },
    {
      "name": "Invalid/Deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E74C3C",
        "fontStyle": "underline"
      }
    }
  ]
}